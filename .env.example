# Modelo das variaveis de ambiente (NAO coloque senhas reais em arquivos versionados).
# A aplicacao le estas variaveis do sistema; este arquivo e apenas um guia.

DB_URL=jdbc:oracle:thin:@HOST:1521:SID
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# Segredo que assina os tokens de login (minimo 16 caracteres). Sem ele, os logins caem a cada reinicio.
AUTH_SECRET=um-segredo-longo-e-aleatorio

# Administrador inicial (os admins da carga do SQL tem senha de demonstracao e nao logam).
# Cria a conta ou ativa uma existente, com esta senha (minimo 6 caracteres).
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=defina-uma-senha

# Endereco(s) do front-end, separados por virgula (opcional).
# Sem esta variavel o CORS fica liberado para qualquer origem.
CORS_ORIGINS=https://seu-front.exemplo.com
